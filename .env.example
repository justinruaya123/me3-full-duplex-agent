# Client host: copy to .env. The speech host uses .env.speech.example.
ME3_TTS_BACKEND=local
ME3_KOKORO_DIR=.local/models/kokoro-int8-multi-lang-v1_0
ME3_ASR_BASE_URL=http://127.0.0.1:8002/v1
ME3_ASR_MODEL=mlx-community/whisper-large-v3-turbo
ME3_ASR_API_KEY="${ME3_ASR_API_KEY:-}"
# Used when this client selects server synthesis.
ME3_TTS_BASE_URL=http://127.0.0.1:8002/v1
ME3_TTS_MODEL=mlx-community/Kokoro-82M-bf16
ME3_TTS_VOICE=af_heart
ME3_TTS_API_KEY="${ME3_TTS_API_KEY:-}"

# Choose conversation and delegated work independently. See docs/SETUP.md.
# Foreground alternatives:
#   qwen        -> set BASE_URL, exact MODEL, optional ME3_FOREGROUND_API_KEY.
#   compatible  -> same fields for a standard streaming endpoint, on your chosen host.
#   pi-chat     -> Pi foreground with the lowest available reasoning level.
#   pi-fast     -> set ME3_FOREGROUND_PROVIDER and MODEL, then sign in to Pi.
ME3_FOREGROUND_PROFILE=pi-fast
ME3_FOREGROUND_BASE_URL=
ME3_FOREGROUND_PROVIDER=openai-codex
ME3_FOREGROUND_MODEL=gpt-6-luna
ME3_FOREGROUND_API_KEY="${ME3_FOREGROUND_API_KEY:-}"
# For an OpenRouter foreground, configure its endpoint, serving slug and model.
# Other routes also need the exact returned serving name here.
ME3_FOREGROUND_PROVIDER_NAME=
# Optional literal stop sequence for compatible servers; quote special tokens.
# ME3_FOREGROUND_STOP='<|im_end|>'
# Worker alternatives:
#   direct + qwen/compatible -> fill ME3_WORKER_BASE_URL, exact MODEL and optional key.
#   direct + openrouter      -> leave BASE_URL empty; keep the GPT-OSS model below.
#   pi + other Pi provider   -> set its exact provider and MODEL, then sign in to Pi.
ME3_HARNESS=pi
ME3_WORKER_PROVIDER=openrouter
ME3_WORKER_MODEL=openai/gpt-oss-120b
ME3_WORKER_BASE_URL=
ME3_WORKER_API_KEY="${ME3_WORKER_API_KEY:-}"
# To select another OpenRouter model, set its exact ID above and fill both
# values below with its provider slug and the returned provider display name.
ME3_WORKER_ROUTING_PROVIDER=
ME3_WORKER_ROUTING_PROVIDER_NAME=
OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}"
BRAVE_SEARCH_API_KEY="${BRAVE_SEARCH_API_KEY:-}"
# Optional when Brave issues separate keys for Answers and Web Search.
BRAVE_ANSWERS_API_KEY="${BRAVE_ANSWERS_API_KEY:-}"
PI_CODING_AGENT_DIR=.local/pi

ME3_STATE_DIR=.local/runtime
# Optional: give everyday conversations their own state directory and owner.
# ME3_PI_STATE=.local/conversation
# ME3_PI_OWNER=local-operator
# Interactive startup: verified (default), demo (trusted room), or off (F6 to start).
# ME3_PI_VOICE_MODE=verified
ME3_MEMORY_ENABLED=0
ME3_WAKE_PHRASE=
ME3_SPEAKER_BASE_URL=http://127.0.0.1:8070
ME3_SPEAKER_API_KEY="${ME3_SPEAKER_API_KEY:-}"
ME3_AUDIO_MODE=headphones

# BMO voice and project Pi
ME3_FOREGROUND_THINKING=off
ME3_WORKER_THINKING=high
ME3_WORKER_API_KEY_ENV=OPENROUTER_API_KEY
ME3_VOICE_TTS=bmo
DEEPGRAM_API_KEY="${DEEPGRAM_API_KEY:-}"
