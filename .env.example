# Copy to .env; fill exact provider/model IDs. No model is silently selected.
export ME3_HARNESS=pi
export ME3_PI_BIN=''
export PI_CODING_AGENT_DIR="$PWD/.local/pi"
export ME3_WORKER_PROVIDER=openai-codex
# Mac-tested selection; verify your own Pi account/model access separately.
export ME3_WORKER_MODEL=gpt-6.1-sol
# Optional API-key provider: explicitly name its credential environment variable.
# export ME3_WORKER_API_KEY_ENV=YOUR_PROVIDER_KEY_VARIABLE

# Choose qwen (API) or nemotron (your separately hosted MLX service).
export ME3_FOREGROUND_PROFILE=qwen
export ME3_FOREGROUND_BASE_URL=''
export ME3_FOREGROUND_MODEL=''
export ME3_FOREGROUND_API_KEY=''

# Separately hosted MLX Whisper large-v3-turbo and Kokoro services.
export ME3_ASR_BASE_URL='http://127.0.0.1:8002/v1'
export ME3_ASR_MODEL='mlx-community/whisper-large-v3-turbo'
export ME3_ASR_API_KEY=''
export ME3_TTS_BASE_URL='http://127.0.0.1:8002/v1'
export ME3_TTS_MODEL='mlx-community/Kokoro-82M-bf16'
export ME3_TTS_VOICE='af_heart'
export ME3_TTS_API_KEY=''
export ME3_STATE_DIR="$PWD/.local/runtime"
# Explicit wake phrase is required for voice; wake alone never enrolls an owner.
export ME3_WAKE_PHRASE=''

# Required by the included separate speech service. Choose the token yourself;
# set ASR_API_KEY and TTS_API_KEY above to the same value for this service.
export ME3_SPEECH_SERVER_TOKEN=''
# Ownership requires an independent authenticated speaker/overlap/addressee service.
export ME3_SPEAKER_BASE_URL=''
export ME3_SPEAKER_API_KEY=''

# Headphone baseline or explicit playback-reference AEC3 speakerphone mode.
export ME3_AUDIO_MODE=headphones
export ME3_AEC_DELAY_MS=0
