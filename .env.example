# Project Pi and voice. Copy to .env. Keep the filled file private.
ME3_FOREGROUND_PROVIDER=openrouter
ME3_FOREGROUND_MODEL=deepseek/deepseek-v4.1-flash
ME3_FOREGROUND_THINKING=off
ME3_WORKER_PROVIDER=openrouter
ME3_WORKER_MODEL=deepseek/deepseek-v4.1-flash
ME3_WORKER_THINKING=high
ME3_WORKER_API_KEY_ENV=OPENROUTER_API_KEY
ME3_VOICE_TTS=bmo
OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}"
DEEPGRAM_API_KEY="${DEEPGRAM_API_KEY:-}"
BRAVE_SEARCH_API_KEY="${BRAVE_SEARCH_API_KEY:-}"

# Optional separate Parakeet service
ME3_PARAKEET_URL=
