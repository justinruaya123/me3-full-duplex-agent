# Copy to .env; fill exact provider/model IDs. No model is silently selected.
export ME3_HARNESS=pi
export ME3_PI_BIN="$(command -v pi)"
export PI_CODING_AGENT_DIR="$PWD/.local/pi"
export ME3_WORKER_PROVIDER=''
export ME3_WORKER_MODEL=''

# Choose qwen (API) or nemotron (your separately hosted MLX service).
export ME3_FOREGROUND_PROFILE=qwen
export ME3_FOREGROUND_BASE_URL=''
export ME3_FOREGROUND_MODEL=''
export ME3_FOREGROUND_API_KEY=''

# Separately hosted MLX Whisper large-v3-turbo and Kokoro services.
export ME3_ASR_BASE_URL=''
export ME3_ASR_MODEL=''
export ME3_ASR_API_KEY=''
export ME3_TTS_BASE_URL=''
export ME3_TTS_MODEL=''
export ME3_TTS_VOICE=''
export ME3_TTS_API_KEY=''
export ME3_STATE_DIR="$PWD/.local/runtime"
# Explicit wake phrase is required for voice; wake alone never enrolls an owner.
export ME3_WAKE_PHRASE=''
